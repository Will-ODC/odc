{
  "name": "@odc/verifier-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Second, independent ODC export verifier (TypeScript). Built from contracts/ alone.",
  "bin": {
    "odc-verify-ts": "dist/src/cli.js"
