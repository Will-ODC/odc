{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "VITE_PULSE_FIRST_POLL_ID",
        "VITE_PULSE_DATA_POLL_ID",
        "VITE_PULSE_FUNDING_POLL_ID",
        "VITE_PULSE_REVOTE_POLL_ID"
      ],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "env": [
        "PULSE_DATABASE_URL",
        "PULSE_REQUIRE_DATABASE",
        "LEDGER_DATABASE_URL",
        "LEDGER_REQUIRE_DATABASE"
      ]
    },
    "lint": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@odc/pulse-integration#test": {
      "dependsOn": ["^build"]
    }
  }
}
